{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Pane",
  "version": "0.1.0",
  "identifier": "com.thepane.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pane",
        "url": "index.html",
        "title": "The Pane",
        "x": 0,
        "y": 0,
        "width": 360,
        "height": 800,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "desktop",
        "url": "widgets/index.html",
        "title": "The Pane desktop",
        "x": 0,
        "y": 0,
        "width": 800,
        "height": 600,
        "visible": false,
        "focus": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A new home for Windows.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
